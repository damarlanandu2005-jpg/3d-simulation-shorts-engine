{
  "name": "cloth_sphere_demo",
  "simulation": "cloth",
  "seed": 0,
  "resolutions": [64, 1024, 4096, 16384],
  "fps": 30,
  "duration": 4.0,
  "object": {"type": "sphere", "cloth_size": 4.4, "cloth_drop_height": 1.3},
  "physics": {"gravity": 9.81, "mass": 0.3, "tension": 15, "compression": 15, "shear": 15,
              "bending": 0.5, "air_damping": 1.0, "quality": 7, "self_collision": true},
  "camera": {"distance": 11.0, "height": 4.8, "target_z": 1.0, "focal_length": 50},
  "material": {"object_color": [0.05, 0.55, 0.1, 1.0], "cloth_style": "wireframe"},
  "render": {"engine": "CYCLES", "samples": 16, "device": "AUTO", "denoise": false},
  "output": {"width": 720, "height": 1280, "dir": "output"},
  "label": {"template": "{faces_short} FACE", "size": 0.2},
  "video": {"hook_seconds": 2.0, "crf": 18}
}
